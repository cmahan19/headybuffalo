# Copy to .env.local (never commit real values).

# Public site URL used for canonical links, sitemap, and Stripe redirects.
NEXT_PUBLIC_SITE_URL=https://headybuffalo.com

# Optional public support email. Leave blank to hide it and use the contact form + phone.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Stripe (Dashboard → Developers → API keys). Checkout returns a friendly "unavailable" message until set.
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for /api/stripe/webhook.
STRIPE_WEBHOOK_SECRET=

# Contact form email delivery (any SMTP provider; e.g. Google Workspace app password, Postmark, SES).
# (Legacy EMAIL_USER / EMAIL_PASS are also accepted and default to Gmail SMTP, delivering to EMAIL_USER.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Sender address (must be allowed by your SMTP provider). Defaults to SMTP_USER.
CONTACT_FROM_EMAIL=

# --- Admin (private /admin area). Leave ADMIN_PASSWORD empty to disable admin entirely (404). ---
ADMIN_PASSWORD=
# Long random string used to sign admin session cookies (defaults to ADMIN_PASSWORD).
ADMIN_SESSION_SECRET=
# Where admin decisions, audit events, and click logs are stored (JSON). Needs a writable disk.
HB_DATA_DIR=

# --- Feature flags (all OFF unless exactly "true"). Rebuild after changing: static pages read them at build time. ---
MARKETPLACE_ENABLED=false
SUBSCRIPTIONS_ENABLED=false
AFFILIATE_PRODUCTS_ENABLED=false
# Only with a real email-list provider:
NEWSLETTER_ENABLED=false
NEWSLETTER_PROVIDER_URL=
# Public concept showcase (/ideas + homepage module). Set to "false" to hide.
CONCEPT_SHOWCASE=true
# Never set in production: previews unverified draft products.
SHOW_DRAFT_PRODUCTS=false
